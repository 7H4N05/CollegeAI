# Server Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# JWT Security
SECRET_KEY=collegeai_hackathon_super_secret_jwt_key_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Set GEMINI_API_KEY or OPENAI_API_KEY to enable live LLM integration.
# If unconfigured, backend seamlessly uses the high-precision deterministic tool engine.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini

# Database
DATABASE_URL=sqlite:///./collegeai.db
